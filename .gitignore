# La configuration SFTP peut contenir le mot de passe de l'hébergement OVH.
# Elle reste sur cet ordinateur et ne doit jamais être envoyée sur GitHub.
/.vscode/sftp.json
/.vscode/command-buttons.json
/.secrets/


# La version Word modifiable reste locale : le site publie uniquement le PDF fixe.
/public/assets/documents/CV/*-modifiable.odt

# Les consignes locales de collaboration ne doivent pas être publiées.
/AGENTS.md

# Dépendances et feuilles de style générées localement.
/node_modules/
/css/*.css
/css/*.css.map
/dist/
